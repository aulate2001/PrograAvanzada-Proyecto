@{
    ViewData["Title"] = "Órdenes de servicio";
}

<div class="mb-4">
    <h1 class="h2 mb-1">Órdenes de servicio</h1>
    <p class="text-muted mb-0">Consulta de órdenes registradas. Los datos se cargan desde la Web API sin recargar la página.</p>
</div>

<!-- Contadores por estado -->
<div class="row g-3 mb-4" id="contadores">
    <div class="col-6 col-md-3">
        <div class="card text-center border-secondary"><div class="card-body py-3">
            <div class="small text-muted">Pendiente</div>
            <div class="fs-3 fw-bold" data-contador="1">0</div>
        </div></div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card text-center border-warning"><div class="card-body py-3">
            <div class="small text-muted">En reparación</div>
            <div class="fs-3 fw-bold" data-contador="2">0</div>
        </div></div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card text-center border-info"><div class="card-body py-3">
            <div class="small text-muted">Listo</div>
            <div class="fs-3 fw-bold" data-contador="3">0</div>
        </div></div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card text-center border-success"><div class="card-body py-3">
            <div class="small text-muted">Entregado</div>
            <div class="fs-3 fw-bold" data-contador="4">0</div>
        </div></div>
    </div>
</div>

<!-- Filtro por estado -->
<div class="row g-2 align-items-end mb-3">
    <div class="col-sm-6 col-md-4">
        <label for="filtroEstado" class="form-label">Filtrar por estado</label>
        <select id="filtroEstado" class="form-select">
            <option value="">Todos</option>
            <option value="1">Pendiente</option>
            <option value="2">En reparación</option>
            <option value="3">Listo</option>
            <option value="4">Entregado</option>
        </select>
    </div>
</div>

<div id="mensajeOrdenes" role="alert"></div>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle" id="tablaOrdenes">
        <thead>
            <tr>
                <th>Equipo</th>
                <th>Cliente</th>
                <th class="text-end">Costo</th>
                <th>Estado</th>
                <th class="text-end">Acción</th>
            </tr>
        </thead>
        <tbody>
            <tr><td colspan="5" class="text-center text-muted py-4">Cargando órdenes...</td></tr>
        </tbody>
    </table>
</div>

@section Scripts {
    <script src="~/js/ordenes/consultaOrdenes.js" asp-append-version="true"></script>
}
